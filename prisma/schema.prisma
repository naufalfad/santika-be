datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  PASTOR
  BENDAHARA
  DEWAN_KEUANGAN
  KETUA_KOMISI
  TIM_PEMBANGUNAN
  SEKRETARIAT
}

enum KategoriKegiatan {
  OMK
  LITURGI
  SOSIAL
  PENDIDIKAN
  PASTORAL
  LINGKUNGAN
  PEMELIHARAAN
  OPERASIONAL
  LAINNYA
}

enum PrioritasKegiatan {
  RENDAH
  SEDANG
  TINGGI
  DARURAT
}

enum StatusKegiatan {
  DRAFT
  DIAJUKAN
  DIREVIEW
  DISETUJUI
  DITOLAK
  SELESAI
}

enum JenisDokumenKegiatan {
  PROPOSAL
  SURAT_PERMOHONAN
  RAB
  JADWAL_ACARA
  SURAT_TUGAS
  NOTULENSI
  FOTO_PENDUKUNG
  LAINNYA
}

enum StatusPermohonanAnggaran {
  DRAFT
  DIAJUKAN
  DIREVIEW_BENDAHARA
  MENUNGGU_PERSETUJUAN
  DISETUJUI
  DITOLAK
  DICAIRKAN
  SELESAI
}

enum SpjStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum FileType {
  PDF
  IMAGE
}

model Paroki {
  id           String        @id @default(uuid())
  nama         String        @unique
  alamat       String
  keuskupan    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  users        User[]
  komisi       Komisi[]
  budgets      Budget[]
  specialFunds SpecialFund[]
  auditLogs    AuditLog[]

  fundCategories   FundCategory[]
  incomeTypes      IncomeType[]
  expenseTypes     ExpenseType[]
  cashTransactions CashTransaction[]
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  password     String
  name         String
  role         Role
  // Avatar URL — satu-satunya field yang boleh diedit mandiri oleh pengguna.
  // Audit trail (name, email, role, parokiId) adalah READ-ONLY untuk menjaga
  // integritas akuntabilitas pada AuditLog dan ApprovalHistory.
  avatarUrl    String?
  isActive     Boolean           @default(true)
  parokiId     String
  paroki       Paroki            @relation(fields: [parokiId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  pengajuanKegiatan   PengajuanKegiatan[]
  permohonanAnggaran  PermohonanAnggaran[]  @relation("PemohonAnggaran")
  reviewedAnggaran    PermohonanAnggaran[]  @relation("ReviewerAnggaran")
  approvedAnggaran    PermohonanAnggaran[]  @relation("ApproverAnggaran")
  approvals           ApprovalHistory[]
  auditLogs           AuditLog[]
  createdTransactions CashTransaction[] @relation("CreatedTransactions")
  specialFundAllocations SpecialFundAllocation[]
}

model Komisi {
  id           String        @id @default(uuid())
  nama         String
  parokiId     String
  paroki       Paroki        @relation(fields: [parokiId], references: [id])
  createdAt    DateTime      @default(now())
  
  budgetItems  BudgetItem[]
  kegiatan     PengajuanKegiatan[]
}

model Budget {
  id             String        @id @default(uuid())
  tahun          Int
  fundCategoryId String
  fundCategory   FundCategory  @relation(fields: [fundCategoryId], references: [id])
  parokiId       String
  paroki         Paroki        @relation(fields: [parokiId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          BudgetItem[]

  @@unique([parokiId, fundCategoryId, tahun])
}

model BudgetItem {
  id           String            @id @default(uuid())
  budgetId     String
  budget       Budget            @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name         String
  plafon       Decimal           @db.Decimal(15, 2)
  komisiId     String?
  komisi       Komisi?           @relation(fields: [komisiId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  
  cashTransactions CashTransaction[]
}

enum SpecialFundStatus {
  DRAFT
  AKTIF
  DITUTUP
}

model SpecialFund {
  id                 String                  @id @default(uuid())
  code               String                  // e.g. "SF-001"
  name               String
  description        String?
  tujuanPenggalangan String?
  targetNominal      Decimal?                @db.Decimal(15, 2)
  balance            Decimal                 @default(0) @db.Decimal(15, 2)
  income             Decimal                 @default(0) @db.Decimal(15, 2)
  expense            Decimal                 @default(0) @db.Decimal(15, 2)
  tanggalMulai       DateTime
  tanggalSelesai     DateTime
  status             SpecialFundStatus       @default(DRAFT)
  parokiId           String
  paroki             Paroki                  @relation(fields: [parokiId], references: [id])
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  transactions       CashTransaction[]
  allocations        SpecialFundAllocation[]
  fundCategoryId     String?                 @unique
  fundCategory       FundCategory?           @relation(fields: [fundCategoryId], references: [id])

  @@unique([parokiId, code])
}

model SpecialFundAllocation {
  id              String       @id @default(uuid())
  specialFundId   String
  specialFund     SpecialFund  @relation(fields: [specialFundId], references: [id], onDelete: Cascade)
  targetPosDanaId String
  targetPosDana   FundCategory @relation(fields: [targetPosDanaId], references: [id])
  nominal         Decimal      @db.Decimal(15, 2)
  tanggal         DateTime     @default(now())
  keterangan      String?
  createdById     String
  createdBy       User         @relation(fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())
}

model PengajuanKegiatan {
  id                String            @id @default(uuid())
  nomorKegiatan     String            @unique
  namaKegiatan      String
  deskripsiKegiatan String
  tujuanKegiatan    String
  kategoriKegiatan  KategoriKegiatan
  komisiId          String
  komisi            Komisi            @relation(fields: [komisiId], references: [id])
  pemohonId         String
  pemohon           User              @relation(fields: [pemohonId], references: [id])
  lokasi            String
  tanggalMulai      DateTime
  tanggalSelesai    DateTime
  jumlahPeserta     Int
  prioritas         PrioritasKegiatan
  status            StatusKegiatan    @default(DRAFT)
  catatanReview     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  dokumen           KegiatanDokumen[]
  anggaran          PermohonanAnggaran[]
  approvals         ApprovalHistory[]
  spj               Spj[]
}

model KegiatanDokumen {
  id           String               @id @default(uuid())
  kegiatanId   String
  kegiatan     PengajuanKegiatan    @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  namaDokumen  String
  jenisDokumen JenisDokumenKegiatan
  pathFile     String
  ukuranFile   Int
  uploadedBy   String
  uploadedAt   DateTime             @default(now())
}

model PermohonanAnggaran {
  id                String                   @id @default(uuid())
  nomorPermohonan   String                   @unique
  kegiatanId        String
  kegiatan          PengajuanKegiatan        @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  pemohonId         String
  pemohon           User                     @relation("PemohonAnggaran", fields: [pemohonId], references: [id])
  tanggalPermohonan DateTime
  estimasiBiaya     Decimal                  @db.Decimal(15, 2)
  jumlahDiajukan    Decimal                  @db.Decimal(15, 2)
  jumlahDisetujui   Decimal                  @default(0) @db.Decimal(15, 2)
  posDanaId         String?
  posDana           FundCategory?            @relation(fields: [posDanaId], references: [id])
  reviewedById      String?
  reviewedBy        User?                    @relation("ReviewerAnggaran", fields: [reviewedById], references: [id])
  approvedById      String?
  approvedBy        User?                    @relation("ApproverAnggaran", fields: [approvedById], references: [id])
  catatanReview     String?
  status            StatusPermohonanAnggaran @default(DRAFT)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  details           PermohonanAnggaranDetail[]
  cashTransactions  CashTransaction[]
  spj               Spj[]
  approvals         ApprovalHistory[]
}

model PermohonanAnggaranDetail {
  id           String             @id @default(uuid())
  permohonanId String
  permohonan   PermohonanAnggaran @relation(fields: [permohonanId], references: [id], onDelete: Cascade)
  uraian       String
  qty          Int
  satuan       String
  hargaSatuan  Decimal            @db.Decimal(15, 2)
  subtotal     Decimal            @db.Decimal(15, 2)
  keterangan   String?
}

model ApprovalHistory {
  id                    String              @id @default(uuid())
  step                  String              // e.g. "Review Kegiatan", "Review Anggaran", "Persetujuan Pastor"
  action                String              // "SUBMIT" | "APPROVE" | "REJECT" | "REVISE"
  catatan               String?
  tanggal               DateTime            @default(now())
  picId                 String
  pic                   User                @relation(fields: [picId], references: [id])
  kegiatanId            String?
  kegiatan              PengajuanKegiatan?  @relation(fields: [kegiatanId], references: [id])
  permohonanAnggaranId  String?
  permohonanAnggaran    PermohonanAnggaran? @relation(fields: [permohonanAnggaranId], references: [id])
}

model Spj {
  id                String              @id @default(uuid())
  title             String
  amount            Decimal             @db.Decimal(15, 2)
  status            SpjStatus           @default(PENDING)
  uploadedBy        String
  kegiatanId        String?
  kegiatan          PengajuanKegiatan?  @relation(fields: [kegiatanId], references: [id])
  permohonanAnggaranId String?
  permohonanAnggaran PermohonanAnggaran? @relation(fields: [permohonanAnggaranId], references: [id])
  posDanaId         String?
  posDana           FundCategory?       @relation(fields: [posDanaId], references: [id])
  cashTransactionId String?             @unique
  cashTransaction   CashTransaction?    @relation(fields: [cashTransactionId], references: [id])
  createdAt         DateTime            @default(now())

  lampiran          SpjLampiran[]
}

model SpjLampiran {
  id           String     @id @default(uuid())
  kategoriFile String     // "NOTA" | "KWITANSI" | "DOKUMENTASI" | "SURAT_TUGAS"
  spjId        String
  spj          Spj        @relation(fields: [spjId], references: [id])
  attachmentId String     @unique
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
}

model Attachment {
  id           String        @id @default(uuid())
  fileName     String
  fileType     FileType
  fileUrl      String
  fileSize     Int
  createdAt    DateTime      @default(now())

  spjLampiran  SpjLampiran?
  cashTransaction CashTransaction?
}

model FundCategory {
  id           String            @id @default(uuid())
  code         String
  name         String
  description  String?
  isActive     Boolean           @default(true)
  parokiId     String
  paroki       Paroki            @relation(fields: [parokiId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions CashTransaction[]
  budgets      Budget[]
  permohonan   PermohonanAnggaran[]
  spj          Spj[]
  specialFundAllocations SpecialFundAllocation[]
  specialFund            SpecialFund?

  @@unique([parokiId, code])
  @@unique([parokiId, name])
}

model IncomeType {
  id           String            @id @default(uuid())
  code         String
  name         String
  description  String?
  isActive     Boolean           @default(true)
  parokiId     String
  paroki       Paroki            @relation(fields: [parokiId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions CashTransaction[]

  @@unique([parokiId, code])
  @@unique([parokiId, name])
}

model ExpenseType {
  id           String            @id @default(uuid())
  code         String
  name         String
  description  String?
  isActive     Boolean           @default(true)
  parokiId     String
  paroki       Paroki            @relation(fields: [parokiId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions CashTransaction[]

  @@unique([parokiId, code])
  @@unique([parokiId, name])
}

model CashTransaction {
  id              String        @id @default(uuid())
  transactionNo   String
  transactionDate DateTime
  transactionType String        // "INCOME" | "EXPENSE"
  fundCategoryId  String
  fundCategory    FundCategory  @relation(fields: [fundCategoryId], references: [id])
  incomeTypeId    String?
  incomeType      IncomeType?   @relation(fields: [incomeTypeId], references: [id])
  expenseTypeId   String?
  expenseType     ExpenseType?  @relation(fields: [expenseTypeId], references: [id])
  amount          Decimal       @db.Decimal(15, 2)
  description     String
  attachmentId    String?       @unique
  attachment      Attachment?   @relation(fields: [attachmentId], references: [id])
  budgetItemId    String?
  budgetItem      BudgetItem?   @relation(fields: [budgetItemId], references: [id])
  createdById     String
  createdBy       User          @relation("CreatedTransactions", fields: [createdById], references: [id])
  parokiId        String
  paroki          Paroki        @relation(fields: [parokiId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  isUangMuka      Boolean       @default(false)
  status          String        @default("SELESAI") // "SELESAI" | "MENUNGGU_SPJ"
  
  parentTransactionId String?
  parentTransaction   CashTransaction?   @relation("TransactionHierarchy", fields: [parentTransactionId], references: [id])
  childTransactions   CashTransaction[]  @relation("TransactionHierarchy")
  
  spj             Spj?
  permohonanAnggaranId String?
  permohonanAnggaran   PermohonanAnggaran? @relation(fields: [permohonanAnggaranId], references: [id])
  specialFundId   String?
  specialFund     SpecialFund?  @relation(fields: [specialFundId], references: [id])

  @@unique([parokiId, transactionNo])
}

model AuditLog {
  id           String        @id @default(uuid())
  tanggal      DateTime      @default(now())
  type         String        // "IN" | "OUT" | "APPROVE" | "SPJ" | "REJECT" | "REVISE" | "AUTH"
  action       String        // Deskripsi log
  amount       Decimal?      @db.Decimal(15, 2)
  actorId      String
  actor        User          @relation(fields: [actorId], references: [id])
  parokiId     String
  paroki       Paroki        @relation(fields: [parokiId], references: [id])
  oldData      Json?
  newData      Json?
}
